# Velvet Vault configuration — copy to .env and fill in YOUR values.
# No real credentials are shipped with this project.

# Local PostgreSQL connection (create the database first, e.g. "createdb velvet_vault")
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/velvet_vault

# Notes:
# - Library roots, FFmpeg paths, thumbnail settings and the optional login password
#   are configured INSIDE the app (Settings) and stored in the database — not here.
# - Share codes live in data/shares.json as SHA-256 verifiers (never plaintext).
# - The owner-session HMAC key is auto-generated at data/.secret on first run.